# Dev Studio backend environment
DEV_STUDIO_TOKEN=
# Optional fallback if not using phone-stored GitHub token
# DEV_STUDIO_GITHUB_TOKEN=
DEV_STUDIO_HOST=0.0.0.0
DEV_STUDIO_PORT=3847
DEV_STUDIO_PROJECTS_ROOT=
DEV_STUDIO_DATA_DIR=
AGY_PATH=agy
DEV_STUDIO_AUTO_APPROVE=false
DEV_STUDIO_CORS=*
# Path to dev-studio clone on laptop (auto-detected if unset)
# DEV_STUDIO_INSTALL_PATH=
# Command used after remote update (default: npm run start:server)
# DEV_STUDIO_RESTART_COMMAND=npm run dev:server
# DEV_STUDIO_GIT_BRANCH=main
# DEV_STUDIO_ALLOW_REMOTE_UPDATE=true
# DEV_STUDIO_UPDATE_SKIP_INSTALL=false
