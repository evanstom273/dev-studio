{
	"name": "dev-studio",
	"private": true,
	"version": "0.2.2",
	"type": "module",
	"workspaces": [
		"server"
	],
	"scripts": {
		"dev": "vite",
		"dev:server": "npm run dev -w server",
		"dev:all": "npm run dev:server & npm run dev",
		"build": "tsc -b && vite build",
		"build:server": "npm run build -w server",
		"build:all": "npm run build:server && npm run build",
		"start:server": "npm run start -w server",
		"tauri": "tauri",
		"tauri:dev": "tauri dev",
		"tauri:build": "tauri build",
		"build:exe": "powershell -ExecutionPolicy Bypass -File scripts/build-exe.ps1",
		"laptop": "powershell -ExecutionPolicy Bypass -File scripts/start-laptop.ps1",
		"laptop:install": "powershell -ExecutionPolicy Bypass -File scripts/install-laptop-task.ps1",
		"laptop:stop": "powershell -ExecutionPolicy Bypass -File scripts/stop-laptop.ps1",
		"lint": "oxlint",
		"test": "node --test scripts/test-activity.js scripts/test-stt.js",
		"preview": "vite preview"
	},
	"dependencies": {
		"@codemirror/autocomplete": "^6.20.3",
		"@codemirror/commands": "^6.11.0",
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-go": "^6.0.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-markdown": "^6.5.2",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/lang-rust": "^6.0.2",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/lang-yaml": "^6.1.3",
		"@codemirror/language": "^6.12.4",
		"@codemirror/search": "^6.7.1",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.9",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/addon-web-links": "^0.12.0",
		"@xterm/xterm": "^6.0.0",
		"codemirror": "^6.0.2",
		"marked": "^18.0.10",
		"mermaid": "^11.17.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/cli": "^2.11.4",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.4",
		"oxlint": "^1.75.0",
		"typescript": "~6.0.2",
		"vite": "^8.2.0"
	}
}
